{
  "name": "gatsby-starter-morning-dew",
  "version": "0.0.0-development",
  "description": "A Gatsby theme/starter to build lightning-fast blog/websites",
  "keywords": [
    "blog",
    "gatsby",
    "gatsby-plugin",
    "gatsby-theme",
    "starter"
  ],
  "license": "MIT",
  "author": "Maxence Poutord <maxence.poutord@gmail.com>",
  "main": "n/a",
  "scripts": {
    "build": "gatsby build",
    "deploy": "gatsby build && gh-pages -d public -b master",
    "develop": "gatsby develop",
    "format": "prettier --write 'src/**/*.js' 'data/siteConfig.js' 'gatsby-*.js' 'scripts/*.js'",
    "generatePostPreviewImages": "./scripts/generatePostPreviewImages.js",
    "lh": "lighthousebot",
    "semantic-release": "semantic-release",
    "start": "gatsby develop",
    "test": "echo \"Write tests! -> https://gatsby.app/unit-testing\""
  },
  "bin": {
    "generatePostPreviewImages": "./scripts/generatePostPreviewImages.js"
  },
  "dependencies": {
    "@emotion/core": "^10.3.1",
    "@emotion/styled": "^10.3.0",
    "@mdx-js/mdx": "^1.6.22",
    "@mdx-js/react": "^1.6.22",
    "babel-plugin-styled-components": "^1.13.3",
    "disqus-react": "^1.1.5",
    "gatsby": "^3.15.0",
    "gatsby-gallery-simple": "^1.0.3",
    "gatsby-image": "^3.11.0",
    "gatsby-plugin-compile-es6-packages": "^2.1.1",
    "gatsby-plugin-cookie-though": "^1.0.0",
    "gatsby-plugin-google-analytics": "^3.15.0",
    "gatsby-plugin-google-gtag": "^3.15.0",
    "gatsby-plugin-intl": "^0.3.3",
    "gatsby-plugin-manifest": "^3.15.0",
    "gatsby-plugin-mdx": "^2.14.0",
    "gatsby-plugin-offline": "^4.15.0",
    "gatsby-plugin-page-creator": "^3.15.0",
    "gatsby-plugin-react-helmet": "^4.15.0",
    "gatsby-plugin-sharp": "^3.15.0",
    "gatsby-plugin-sitemap": "^4.10.0",
    "gatsby-plugin-styled-components": "^4.15.0",
    "gatsby-remark-autolink-headers": "^4.12.0",
    "gatsby-remark-copy-linked-files": "^4.12.0",
    "gatsby-remark-images": "^5.12.0",
    "gatsby-remark-prismjs": "^5.12.0",
    "gatsby-remark-responsive-iframe": "^4.12.0",
    "gatsby-remark-smartypants": "^4.12.0",
    "gatsby-source-filesystem": "^3.15.0",
    "gatsby-transformer-remark": "^4.12.0",
    "gatsby-transformer-sharp": "^3.15.0",
    "gh-pages": "^3.2.3",
    "polished": "^4.2.2",
    "prismjs": "^1.29.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-helmet": "^6.1.0",
    "styled-components": "^5.3.5"
  },
  "devDependencies": {
    "lighthousebot": "https://github.com/GoogleChromeLabs/lighthousebot",
    "prettier": "^2.0.5",
    "puppeteer": "^1.17.0",
    "semantic-release": "^15.13.18",
    "yaml": "^1.6.0"
  },
  "peerDependencies": {
    "gatsby": "^3.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "overrides": {
    "sharp": "^0.29.3"
  }
